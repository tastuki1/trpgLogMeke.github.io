# ====================
# 依存関係
# ====================
# npm install で復元可能なため、Gitで管理不要
node_modules/

# ====================
# ビルド成果物
# ====================
# npm run build で生成されるため、Gitで管理不要
dist/
dist-ssr/
*.local

# ====================
# エディタ・IDE設定
# ====================
# 個人の開発環境固有の設定のため共有不要
# VSCode
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains (WebStorm, IntelliJ等)
.idea/

# Vim
*.swp
*.swo
*~

# ====================
# OS固有ファイル
# ====================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ====================
# ログファイル
# ====================
# 開発中の一時的な記録のため不要
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ====================
# 環境変数
# ====================
# 秘密情報（APIキー等）を含む可能性があるため除外
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ====================
# テストカバレッジ
# ====================
# テスト実行時に生成されるレポート
coverage/
*.lcov

# ====================
# 学習用ノート（個人用）
# ====================
# 個人の学習記録のため、リポジトリには含めない
knowledge/

# ====================
# 一時ファイル
# ====================
*.tmp
*.temp
.cache/
